# PHALANX Environment Configuration Example
# Copy to .env for local development. Never commit .env or secrets to git.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change-me-in-production-at-least-32-chars-long-example
ALLOWED_HOSTS=*

# Database
DATABASE_URL=postgresql+psycopg://phalanx_app:phalanx_app_password@localhost:5432/phalanx_db

# PayPal Sandbox Credentials (UNVERIFIED / PLACEHOLDER)
PAYPAL_CLIENT_ID=sandbox-client-id-placeholder
PAYPAL_CLIENT_SECRET=sandbox-client-secret-placeholder
PAYPAL_WEBHOOK_ID=sandbox-webhook-id-placeholder
PAYPAL_ENVIRONMENT=sandbox
