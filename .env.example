# PHALANX Environment Configuration Example
# Copy this template to .env for local development.
# NEVER commit real passwords, secrets, tokens, or private keys to version control.

# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_HOSTS=*
DEMO_MODE=true

# Database Credentials & Connection Strings (Phase 2 Architecture)
# POSTGRES_PASSWORD: Administrator password for the PostgreSQL superuser (postgres).
POSTGRES_PASSWORD=
# PHALANX_APP_DB_PASSWORD: Least-privilege application password for the phalanx_app role.
PHALANX_APP_DB_PASSWORD=
# DATABASE_URL: Local connection string used by host development/test processes.
# Example: postgresql+psycopg://phalanx_app:<PHALANX_APP_DB_PASSWORD>@localhost:5433/phalanx_db
DATABASE_URL=
# CONTAINER_DATABASE_URL: Internal connection string used by the docker-compose API container.
# Example: postgresql+psycopg://phalanx_app:<PHALANX_APP_DB_PASSWORD>@db:5432/phalanx_db
CONTAINER_DATABASE_URL=
POSTGRES_PORT=5433
APP_PORT=8000

# Security & Master Cryptographic Secrets
# SECRET_KEY: High-entropy secret (>= 32 bytes) used for HKDF token and key derivation.
SECRET_KEY=
# ADMIN_TOKEN: High-entropy bearer token (>= 24 chars) required for /v1/admin/* endpoints.
ADMIN_TOKEN=
# MANDATE_SIGNING_KEY_HEX: 32-byte (64 hex char) private key seed for Ed25519 mandate issuance.
MANDATE_SIGNING_KEY_HEX=

# PayPal Sandbox Credentials (Orders v2 & Webhook Verification)
# PAYPAL_CLIENT_ID: Client ID from your PayPal Developer Sandbox Dashboard.
PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET: Client Secret from your PayPal Developer Sandbox Dashboard.
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID: Webhook ID registered in PayPal Developer Dashboard for sandbox events.
PAYPAL_WEBHOOK_ID=
# PAYPAL_ENVIRONMENT: Must remain strictly 'sandbox' (never switch to live credentials).
PAYPAL_ENVIRONMENT=sandbox
PAYMENT_RAIL=paypal

# Proxy, Networking & Rate Limiting
FORWARDED_ALLOW_IPS=127.0.0.1,::1
TRUSTED_PROXY_COUNT=0
DEMO_TOKEN_RATE_LIMIT=15

# Background Reconciliation Loop (Manual 56.17)
RECONCILER_ENABLED=false
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_MAX_AGE_SECONDS=86400
